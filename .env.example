# Copy to .env (0600); never commit real credentials. No development login bypass.
PUBLIC_URL=http://localhost:3100
HOST=127.0.0.1
PORT=3100
ALLOW_LOOPBACK_HTTP=true
DATABASE_PATH=.runtime/platform.sqlite
PUBLIC_MEDIA_DIRECTORY=.runtime/public-media
NYXID_ISSUER=
NYXID_CLIENT_ID=
NYXID_CLIENT_SECRET=
NYXID_CMS_AUDIENCE=
NYXID_SERVICE_AUDIENCE=
NYXID_INTROSPECTION_URL=
# Versioned authority bridge; bind to verified target NyxID contracts before Live.
NYXID_AUTHORITY_URL=
NYXID_AUTHORITY_TOKEN=
# Generate each using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
TRACKING_SECRET=
ANALYTICS_ENABLED=false
ANALYTICS_REQUIRE_CONSENT=true
