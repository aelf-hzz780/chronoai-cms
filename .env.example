# Copy to .env (0600); never commit real credentials. No development login bypass.
PUBLIC_URL=http://localhost:3100
HOST=127.0.0.1
# Only the local HTTPS reverse proxy may provide the real client IP.
TRUST_PROXY_CIDRS=
PORT=3100
ALLOW_LOOPBACK_HTTP=true
DATABASE_PATH=.runtime/platform.sqlite
PUBLIC_MEDIA_DIRECTORY=.runtime/public-media
NYXID_ISSUER=nyxid
NYXID_API_URL=
NYXID_DISCOVERY_URL=
NYXID_TOKEN_AUDIENCE=
NYXID_SERVICE_ID=
NYXID_SERVICE_SLUG=
# Supported NyxID 0.75.0 OIDC defaults: identity/read only. See docs for explicit write opt-in.
NYXID_OAUTH_SCOPES=openid profile
NYXID_CMS_CAPABILITY_SCOPES_JSON={"content:read":["profile"]}
NYXID_SERVICE_CAPABILITY_SCOPES_JSON={"content:read":["account:read"]}
# Empty = signed identity + delegation only in entry-specific service mode.
NYXID_SERVICE_CLIENT_IDS=
# Deprecated global capability mapping; do not combine with entry-specific maps.
NYXID_OPERATION_SCOPES_JSON=
NYXID_CONNECTIONS_FILE=.runtime/nyxid-connections.json
NYXID_CLIENT_ID=
NYXID_CLIENT_SECRET=
NYXID_CMS_AUDIENCE=
NYXID_SERVICE_AUDIENCE=
NYXID_INTROSPECTION_URL=
# Generate each using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
TRACKING_SECRET=
ANALYTICS_ENABLED=false
ANALYTICS_REQUIRE_CONSENT=true
DEV_ENABLED=true
DEV_API_URL=https://dev.to/api
HASHNODE_ENABLED=true
HASHNODE_API_URL=https://gql-beta.hashnode.com
MEDIUM_ENABLED=true
HACKERNOON_ENABLED=true

# Public proof requires installed Chromium; isolated, fresh browser context per check.
RENDER_BROWSER_EXECUTABLE=/usr/bin/chromium
RENDER_BROWSER_SANDBOX=true
# Exact additional CSS/script origins required by the configured publication themes.
RENDER_ASSET_ORIGINS=https://cdn.jsdelivr.net
