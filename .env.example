# Copy to .env (0600); never commit real credentials. No development login bypass.
PUBLIC_URL=http://localhost:3100
HOST=127.0.0.1
# Only the local HTTPS reverse proxy may provide the real client IP.
TRUST_PROXY_CIDRS=
PORT=3100
ALLOW_LOOPBACK_HTTP=true
DATABASE_PATH=.runtime/platform.sqlite
PUBLIC_MEDIA_DIRECTORY=.runtime/public-media
# Required before new images: exact site ID -> existing 0700 Worker-owned absolute
# private directory, outside all public roots, on the same filesystem AND mount.
# Docker content volumes: /mounted/<site>/.chrono-private-staging (never images/...).
GHOST_MEDIA_STAGING_JSON=
NYXID_ISSUER=nyxid
NYXID_API_URL=
NYXID_DISCOVERY_URL=
NYXID_TOKEN_AUDIENCE=
NYXID_SERVICE_ID=
NYXID_SERVICE_SLUG=
# Supported NyxID 0.75.0 OIDC defaults: identity/read only. See docs for explicit write opt-in.
NYXID_OAUTH_SCOPES=openid profile
NYXID_CMS_CAPABILITY_SCOPES_JSON={"content:read":["profile"]}
NYXID_SERVICE_CAPABILITY_SCOPES_JSON={"content:read":["account:read"]}
# Empty = signed identity + delegation only in entry-specific service mode.
NYXID_SERVICE_CLIENT_IDS=
# Deprecated global capability mapping; do not combine with entry-specific maps.
NYXID_OPERATION_SCOPES_JSON=
NYXID_CONNECTIONS_FILE=.runtime/nyxid-connections.json
# Each personal connection may explicitly select executionApproval: "native"
# (ordinary NyxID proxy and native policy) or "exact" (content-bound native
# exact-service approval with a supported direct/OAuth caller). Changing the mode
# changes the connection fingerprint; existing confirmations are never converted.
# Organization external distribution always requires exact content/action/target
# Admin authorization; service-origin delegation cannot use the OAuth catalog.
# Ordinary native proxy writes are currently blocked by NATIVE_DISPATCH_UNSUPPORTED:
# it can wait for approval without a CMS cancellation or Publisher recheck callback.
# Read-only proxy calls and supported exact-service requests retain their paths.
# Keep formal outbound paused until independent acceptance; no flag bypasses this.
# Optional connection setup; enable only after registering PUBLIC_URL/connections/return
# as an exact OAuth client redirect URI in NyxID. No owner/org field exists in hosted create.
NYXID_CONNECTION_MANAGEMENT_URL=
# Example only: {"dev":{"enabled":true,"serviceSlug":"actual-catalog-slug","scopes":[]}}
NYXID_CONNECTION_TARGETS_JSON=
NYXID_CONNECTION_ATTEMPT_TTL_SECONDS=900
NYXID_CLIENT_ID=
NYXID_CLIENT_SECRET=
NYXID_CMS_AUDIENCE=
NYXID_SERVICE_AUDIENCE=
NYXID_INTROSPECTION_URL=
# Generate each using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
TRACKING_SECRET=
ANALYTICS_ENABLED=false
ANALYTICS_REQUIRE_CONSENT=true
DEV_ENABLED=true
DEV_API_URL=https://dev.to/api
HASHNODE_ENABLED=true
HASHNODE_API_URL=https://gql-beta.hashnode.com
MEDIUM_ENABLED=true
HACKERNOON_ENABLED=true

# Public proof requires installed Chromium; isolated, fresh browser context per check.
RENDER_BROWSER_EXECUTABLE=/usr/bin/chromium
RENDER_BROWSER_SANDBOX=true
# Exact additional CSS/script origins required by the configured publication themes.
RENDER_ASSET_ORIGINS=https://cdn.jsdelivr.net
