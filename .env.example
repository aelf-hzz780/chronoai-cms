# Copy to .env (0600); never commit real credentials. No development login bypass.
PUBLIC_URL=http://localhost:3100
HOST=127.0.0.1
# Only the local HTTPS reverse proxy may provide the real client IP.
TRUST_PROXY_CIDRS=
PORT=3100
ALLOW_LOOPBACK_HTTP=true
DATABASE_PATH=.runtime/platform.sqlite
PUBLIC_MEDIA_DIRECTORY=.runtime/public-media
NYXID_ISSUER=nyxid
NYXID_API_URL=
NYXID_DISCOVERY_URL=
NYXID_TOKEN_AUDIENCE=
NYXID_SERVICE_ID=
NYXID_SERVICE_SLUG=
# Set to the exact scopes granted in the confidential OAuth client registration.
NYXID_OAUTH_SCOPES=
# Optional explicit operation -> required upstream scopes mapping; omitted = literal scopes.
NYXID_OPERATION_SCOPES_JSON=
NYXID_CONNECTIONS_FILE=.runtime/nyxid-connections.json
NYXID_CLIENT_ID=
NYXID_CLIENT_SECRET=
NYXID_CMS_AUDIENCE=
NYXID_SERVICE_AUDIENCE=
NYXID_INTROSPECTION_URL=
# Generate each using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
TRACKING_SECRET=
ANALYTICS_ENABLED=false
ANALYTICS_REQUIRE_CONSENT=true
DEV_ENABLED=true
DEV_API_URL=https://dev.to/api
HASHNODE_ENABLED=true
HASHNODE_API_URL=https://gql-beta.hashnode.com
MEDIUM_ENABLED=true
HACKERNOON_ENABLED=true
