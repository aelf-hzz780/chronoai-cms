<nav class="pagination" aria-label="{{t "Pagination"}}">
    {{#if prev}}<a class="newer-posts" href="{{page_url prev}}">← {{t "Newer stories"}}</a>{{else}}<span></span>{{/if}}
    <span class="page-number">{{t "Page {page} of {pages}" page=page pages=pages}}</span>
    {{#if next}}<a class="older-posts" href="{{page_url next}}">{{t "Older stories"}} →</a>{{else}}<span></span>{{/if}}
</nav>
