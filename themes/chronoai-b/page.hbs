{{!< default}}
<main id="main-content" class="journal-article">
{{#post}}
    <article class="{{post_class}}">
        {{#if @page.show_title_and_feature_image}}
        <header class="story-heading"><p class="eyebrow">{{@site.title}}</p><h1>{{title}}</h1></header>
        {{#if feature_image}}
        <figure class="story-cover"><img src="{{img_url feature_image size="large"}}" alt="{{feature_image_alt}}" width="1440" decoding="async">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>
        {{/if}}
        {{/if}}
        <section class="reading-body gh-content page-body">{{content}}</section>
    </article>
{{/post}}
</main>
