# Install inside nginx http {}; replace every .example host and certificate path.
# Certificate provisioning and DNS are operator prerequisites, not run by this template.
# No access log: tracker request paths contain signed observation tokens.
server {
    listen 80;
    server_name cms.example en.example zh.example;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name cms.example;
    ssl_certificate /etc/letsencrypt/live/cms.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cms.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 7m;
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
# Repeat this block per site: exact public host, local port and matching certificate.
server {
    listen 443 ssl;
    server_name en.example;
    ssl_certificate /etc/letsencrypt/live/en.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/en.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    location = /ghost { return 404; }
    location ^~ /ghost/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:2568;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
