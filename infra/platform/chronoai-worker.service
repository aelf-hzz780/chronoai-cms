[Unit]
Description=ChronoAI publication worker
After=network-online.target chronoai-api.service
Wants=network-online.target

[Service]
Type=simple
User=chronoai
Group=chronoai
WorkingDirectory=/opt/chronoai/current
EnvironmentFile=/etc/chronoai/platform.env
ExecStart=/opt/node24/bin/node src/worker-main.ts
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chronoai

[Install]
WantedBy=multi-user.target
